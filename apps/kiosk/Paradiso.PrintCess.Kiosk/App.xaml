<Application x:Class="Paradiso.PrintCess.Kiosk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <Color x:Key="InkColor">#FF13242C</Color>
        <Color x:Key="MutedColor">#FF52656D</Color>
        <Color x:Key="CanvasColor">#FFF1F5F3</Color>
        <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
        <Color x:Key="BrandColor">#FF006C66</Color>
        <Color x:Key="AccentColor">#FFE9B949</Color>
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
    </Application.Resources>
</Application>
