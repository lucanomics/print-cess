<Window x:Class="Paradiso.PrintCess.Kiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print-cess by Paradiso — Kiosk"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">
    <Grid Margin="64">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ProductName}" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="Secure self-service document printing" FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Background="#FF8A3B2E" CornerRadius="24" Padding="20,10" Margin="0,0,14,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimulator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="SIMULATOR · 실제 인쇄 안 됨" Foreground="White" FontSize="18" FontWeight="Bold" />
                </Border>
                <Border Background="{StaticResource BrandBrush}" CornerRadius="24" Padding="24,10">
                    <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,42,0,42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                <TextBlock Text="{Binding PrimaryInstruction}" FontSize="48" FontWeight="Bold" TextWrapping="Wrap" LineHeight="62" />
                <TextBlock Text="{Binding SecondaryInstruction}" FontSize="25" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="36" Margin="0,28,0,0" />
                <TextBlock Text="{Binding CountdownText}" FontSize="22" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" Margin="0,28,0,0" />
                <TextBlock Text="{Binding SafeErrorCode}" FontSize="20" Foreground="#FF8A3B2E" Margin="0,18,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="32" Padding="34" BorderBrush="#FFD5E0DC" BorderThickness="2" MinWidth="420" MinHeight="420">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="110" Height="110" CornerRadius="55" Background="#FFE1EFEC">
                            <TextBlock Text="↗" FontSize="58" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="QR 코드를 준비하고 있습니다" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,0" />
                    </StackPanel>
                    <Image Source="{Binding QrCodeImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="휴대전화로 스캔할 인쇄 세션 QR 코드" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="132" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="출력 완료" FontSize="34" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" Margin="0,22,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFE4ECE9" CornerRadius="18" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PDF, JPG, PNG" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="A4 · 한 부 · 단면 · 흑백" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="인쇄 후 파일 자동 삭제" FontSize="18" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
