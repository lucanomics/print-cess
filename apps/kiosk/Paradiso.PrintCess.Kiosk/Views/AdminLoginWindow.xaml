<Window x:Class="Paradiso.PrintCess.Kiosk.Views.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print-cess by Paradiso — 관리자 인증"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}"
        ShowInTaskbar="False">
    <Grid Margin="38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="관리자 인증" FontSize="30" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="외부에서 구성된 관리자 암호를 입력하세요." FontSize="17" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,24" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="56" FontSize="22" Padding="12" MaxLength="128" AutomationProperties.Name="관리자 암호" />
        <TextBlock x:Name="ErrorMessage" Grid.Row="3" Foreground="#FF8A3B2E" FontSize="16" Margin="0,12,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="112" Height="52" Margin="0,0,12,0" Click="OnCancel" />
            <Button Content="확인" Width="112" Height="52" Background="{StaticResource BrandBrush}" Foreground="White" FontWeight="SemiBold" Click="OnAuthenticate" />
        </StackPanel>
    </Grid>
</Window>
